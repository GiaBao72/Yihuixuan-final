/* PRODUCT DETAIL - BENTO GRID LAYOUT */

.pd-section {
  padding: 100px 0;
  position: relative;
}

.pd-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 40px;
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 60px;
  align-items: start;
}

.pd-container.pd-reverse {
  grid-template-columns: 1.2fr 1fr;
}

.pd-container.pd-reverse .pd-text-side {
  order: 2;
}

.pd-container.pd-reverse .pd-masonry-side {
  order: 1;
}

/* Text Side */
.pd-text-side {
  position: sticky;
  top: 120px;
}

.pd-text-content {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.pd-header {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 8px;
}

.pd-num {
  font-size: 72px;
  font-weight: 900;
  background: linear-gradient(135deg, #1b5fd4 0%, #4a90e2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1;
  animation: neonPulse 3s ease-in-out infinite;
}

@keyframes neonPulse {
  0%, 100% { filter: drop-shadow(0 0 20px rgba(27, 95, 212, 0.5)); }
  50% { filter: drop-shadow(0 0 40px rgba(74, 144, 226, 0.8)); }
}

.pd-label {
  font-size: 14px;
  font-weight: 700;
  color: #4a90e2;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.pd-title {
  font-size: 56px;
  font-weight: 900;
  line-height: 1.1;
  color: #fff;
  margin: 0;
}

.pd-title em {
  background: linear-gradient(135deg, #1b5fd4 0%, #4a90e2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-style: normal;
}

.pd-desc {
  font-size: 18px;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.7);
  margin: 0;
}

/* Info Cards */
.pd-section-box {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  padding: 24px;
  transition: all 0.3s;
}

.pd-section-box:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(74, 144, 226, 0.3);
  transform: translateY(-2px);
}

.pd-section-title {
  font-size: 16px;
  font-weight: 700;
  color: #4a90e2;
  margin: 0 0 16px 0;
}

.pd-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pd-list li {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.8);
  padding-left: 24px;
  position: relative;
  line-height: 1.6;
}

.pd-list li::before {
  content: '→';
  position: absolute;
  left: 0;
  color: #4a90e2;
  font-weight: 700;
}

.pd-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.pd-tag {
  display: inline-block;
  padding: 8px 16px;
  background: rgba(74, 144, 226, 0.1);
  border: 1px solid rgba(74, 144, 226, 0.3);
  border-radius: 8px;
  font-size: 14px;
  color: #4a90e2;
  font-weight: 600;
  transition: all 0.3s;
}

.pd-tag:hover {
  background: rgba(74, 144, 226, 0.2);
  border-color: #4a90e2;
  transform: translateY(-2px);
}

.pd-cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 32px;
  background: linear-gradient(135deg, #1b5fd4 0%, #4a90e2 100%);
  color: #fff;
  font-weight: 700;
  font-size: 16px;
  text-decoration: none;
  border-radius: 12px;
  transition: all 0.3s;
  box-shadow: 0 8px 32px rgba(27, 95, 212, 0.3);
  align-self: flex-start;
}

.pd-cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 48px rgba(27, 95, 212, 0.5);
}

/* Masonry Grid Side - BENTO LAYOUT */
.pd-masonry-side {
  position: relative;
}

/* Single Video (Product 01) */
.masonry-single-video {  width: 100%;  aspect-ratio: 16 / 9;  max-height: 600px;  border-radius: 16px;  overflow: hidden;  background: rgba(255, 255, 255, 0.03);  border: 1px solid rgba(255, 255, 255, 0.1);}
.masonry-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(4, 150px);
  gap: 16px;
}

.masonry-item {
  position: relative;
  overflow: hidden;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s;
}

.masonry-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(27, 95, 212, 0.3);
  border-color: rgba(74, 144, 226, 0.5);
}

.masonry-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s;
}

.masonry-item:hover img {
  transform: scale(1.1);
}

/* Bento Grid Heights */
.masonry-h1 { grid-row: span 2; }
.masonry-h2 { grid-row: span 1; }
.masonry-h3 { grid-row: span 2; }

/* Bento Grid Positions */
.masonry-item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
.masonry-item:nth-child(2) { grid-column: span 1; grid-row: span 1; }
.masonry-item:nth-child(3) { grid-column: span 1; grid-row: span 1; }
.masonry-item:nth-child(4) { grid-column: span 1; grid-row: span 2; }
.masonry-item:nth-child(5) { grid-column: span 2; grid-row: span 2; }
.masonry-item:nth-child(6) { grid-column: span 1; grid-row: span 1; }
.masonry-item:nth-child(7) { grid-column: span 1; grid-row: span 1; }
.masonry-item:nth-child(8) { grid-column: span 1; grid-row: span 1; }
.masonry-item:nth-child(9) { grid-column: span 1; grid-row: span 1; }

/* Video Thumbnail */
.masonry-video {
  position: relative;
  width: 100%;
  height: 100%;
}

.masonry-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60px;
  height: 60px;
  background: rgba(27, 95, 212, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24px;
  transition: all 0.3s;
}

.masonry-item:hover .masonry-play {
  background: #1b5fd4;
  transform: translate(-50%, -50%) scale(1.1);
}

/* Mobile View */
.masonry-mobile {
  display: none;
}

/* Responsive */
@media (max-width: 1024px) {
  .pd-container {
    grid-template-columns: 1fr;
    gap: 60px;
  }
  
  .pd-container.pd-reverse {
    grid-template-columns: 1fr;
  }
  
  .pd-container.pd-reverse .pd-text-side {
    order: 1;
  }
  
  .pd-container.pd-reverse .pd-masonry-side {
    order: 2;
  }
  
  .pd-text-side {
    position: relative;
    top: 0;
  }
  
  .pd-num {
    font-size: 56px;
  }
  
  .pd-title {
    font-size: 42px;
  }
  
  .masonry-desktop {
    display: none;
  }
  
  .masonry-mobile {
    display: block;
  }
  
  .masonry-item-single {
    width: 100%;
    height: 400px;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .masonry-item-single img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .masonry-single-video {
    height: 400px;
  }
}